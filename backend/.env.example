# SQLite file (created on first run)
DATABASE_PATH=night_ledger.db

# Optional: verify Retell webhook signatures and use Retell APIs
RETELL_API_KEY=

# Optional: TypeSafe Jev classifier. Leave empty to run rules only.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.6

# Default nurse line used when no on-duty line is set (E.164)
NURSE_LINE=+12139940320

# How often the supervisor engine checks the line (seconds)
ENGINE_INTERVAL_S=5
