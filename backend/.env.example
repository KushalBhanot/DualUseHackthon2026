DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger

# dashboard.retellai.com → API Keys. Also used to verify webhook signatures.
RETELL_API_KEY=

# TypeSafe Jev. Leave empty to run with rules only.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.6

# Fallback nurse line (E.164) when the nurse_lines table has no on-duty line.
NURSE_LINE=+12139940320

# Set to 0 only for local curl tests without Retell signatures.
VERIFY_RETELL_SIGNATURE=1
